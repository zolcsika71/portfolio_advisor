@startuml
' Status: Implemented
' Verified against: src/portfolio_advisor/database/migrations/shortlist_classification.py
' Verified against: src/portfolio_advisor/database/migrations/shortlist_classification_composition.py
' Verified against: src/portfolio_advisor/database/migrations/shortlist_classification_pair_mapping.py
' Verified against: src/portfolio_advisor/database/migrations/shortlist_parallel.py
' Verified against: src/portfolio_advisor/construction/evidence.py
' Verified against: src/portfolio_advisor/construction/persistence.py
' Verified by: tests/test_shortlist_classification_corrections.py
title Shortlist classification correction composition [Implemented]

actor Operator
participant "Admission command" as CLI
database "portfolio_advisor.sqlite" as DB
participant "Correction validator" as Validator
participant "Construction evidence resolver" as Resolver
participant "Persistence validator" as Persistence
participant "Copy-on-write importer" as Importer

box "Explicit operator write boundary" #FFF2CC
Operator -> CLI: database, new backup, correction identity,\ndataset fingerprint, original hash, authorization, reason,\nexact prior-label counts or reviewed pair manifest, --apply
CLI -> DB: SQLite backup API to separate path
CLI -> DB: inspect correction identity
alt Existing identity: retry
  CLI -> Validator: validate DDL, ordered admissions,\nand stable evidence sets
  alt Every admission binding matches
    Validator --> CLI: exact replay; no records added
  else Any binding differs
    Validator --> CLI: reject without mutation
  end
else New identity
  CLI -> CLI: verify database hash equals authorized pre-write hash
  alt Hash mismatch
    CLI --> Operator: reject before schema or data mutation
  else Hash matches
    alt v2 explicit sub-asset replacement
      CLI -> Validator: inventory current effective labels containing ?\nand match every authorized label/count
    else v3 reviewed asset/sub-asset mapping
      CLI -> Validator: verify manifest hash, 77 exact prior pairs,\ncoverage/counts, 51 results, and group effects
    end
    CLI -> DB: BEGIN IMMEDIATE
    CLI -> DB: install immutable ordered admission/items\nand composed effective/stage views
    CLI -> Validator: bind workbook hash, sheet, row, snapshot,\nISIN, asset class, raw JSON, original label,\nexpected prior effective label, and replacement result
    alt Evidence missing, changed, ambiguous, or out of scope
      Validator -> DB: ROLLBACK
      Validator --> Operator: reject with no partial admission
    else Exact authorized set
      Validator -> DB: verify ordered composition, integrity,\nforeign keys, and projection
      CLI -> DB: COMMIT
      CLI --> Operator: item count and correction-set fingerprint
    end
  end
end
end box

Resolver -> Validator: validate the complete installed correction contract once\nand bind the current SQLite data version
loop Each shortlist entry in the batch
  Resolver -> DB: verify bound data version, then read original\nand selected composed classification stage
  DB --> Resolver: v1 exact mapping, v2 sub-asset replacement,\nthen v3 asset/sub-asset pair mapping
end
Resolver -> DB: verify bound data version after the batch
alt Database changed after validation
  Resolver --> Resolver: reject stale binding; do not reuse validation
end
Resolver -> Resolver: retain conflict status; group on effective asset/sub-asset

Persistence -> DB: read stored candidate provenance
alt Candidate binds active aggregate correction set
  Persistence -> Resolver: validate with latest effective classifications
else Candidate binds a validated historical correction stage
  Persistence -> DB: resolve its exact ordered stage
  Persistence -> Resolver: validate with that stage's classifications
else Historical candidate has no correction binding
  Persistence -> DB: validate against original classifications
end

Importer -> DB: rebuild shortlist candidate from workbook evidence
alt Stable evidence reproduces every admitted set
  Importer -> Validator: validate metric, legacy classification,\nand composed classification corrections
  Validator --> Importer: publish candidate
else Dataset or source binding changed
  Validator --> Importer: fail closed
  Importer -> Importer: discard candidate; retain installed database
end

note over DB
Original columns, raw JSON, conflict flags, the 1,278 v1 items,
the 287 v2 items, and metric corrections are unchanged.
The v3 English mapping is an explicit dataset-bound admission;
NULL values pass through, and future datasets or mappings require
separate review and authorization.
end note
@enduml
